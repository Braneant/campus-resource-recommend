// ============================================================
// neo4j_init.cypher  知识图谱初始化（严格依据 02-知识图谱设计.md）
// 与 MySQL 关联键：Resource.resource_id == learning_resource.resource_no
// 执行方式：Neo4j Browser 粘贴执行，或用 cypher-shell / driver 批量执行
// ============================================================

// 4.1 约束与索引
CREATE CONSTRAINT college_id_unique IF NOT EXISTS FOR (c:College) REQUIRE c.id IS UNIQUE;
CREATE CONSTRAINT major_id_unique IF NOT EXISTS FOR (m:Major) REQUIRE m.id IS UNIQUE;
CREATE CONSTRAINT course_id_unique IF NOT EXISTS FOR (c:Course) REQUIRE c.id IS UNIQUE;
CREATE CONSTRAINT kp_id_unique IF NOT EXISTS FOR (k:KnowledgePoint) REQUIRE k.id IS UNIQUE;
CREATE CONSTRAINT resource_id_unique IF NOT EXISTS FOR (r:Resource) REQUIRE r.resource_id IS UNIQUE;
CREATE INDEX kp_name_idx IF NOT EXISTS FOR (k:KnowledgePoint) ON (k.name);
CREATE INDEX kp_heat_idx IF NOT EXISTS FOR (k:KnowledgePoint) ON (k.heat);
CREATE INDEX resource_heat_idx IF NOT EXISTS FOR (r:Resource) ON (r.heat);

// ---- College 节点 ----
MERGE (c:College {id:1, name:'计算机学院', code:'CS', description:'计算机科学与技术学院，涵盖计算机、人工智能等方向'});
MERGE (c:College {id:2, name:'信息工程学院', code:'INFO', description:'信息与电子工程，含电子信息、通信、自动化'});
MERGE (c:College {id:3, name:'软件学院', code:'SE', description:'软件工程、网络工程，侧重工程实践'});
